# mStock Type A credentials (https://trade.mstock.com -> Trading APIs)
MSTOCK_API_KEY=

# Login: either a TOTP secret (preferred, generates a fresh code per run)
MSTOCK_TOTP_SECRET=
# ...or a 6-digit TOTP pasted for a single run
MSTOCK_TOTP=
# ...or an access token minted today (valid 12h / until midnight)
MSTOCK_ACCESS_TOKEN=

# Optional: only needed if the login flow asks for username/password first
MSTOCK_USERNAME=
MSTOCK_PASSWORD=

# Optional overrides (testing / staging)
# MSTOCK_BASE_URL=https://api.mstock.trade/openapi/typea
# MSTOCK_WS_URL=wss://ws.mstock.trade

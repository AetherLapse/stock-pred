# ---------------------------------------------------------------------------
# Only two things are required: the API key, and one way to get a session.
# Everything else has a working default baked into the code.
# ---------------------------------------------------------------------------

# 1) mStock API key — trade.mstock.com -> Trading APIs
MSTOCK_API_KEY=

# 2) Session credential — pick ONE:
#    a) TOTP secret (best: a fresh code every run, never expires)
MSTOCK_TOTP_SECRET=
#    b) a 6-digit TOTP pasted for one run (~30 s validity)
# MSTOCK_TOTP=
#    c) an access token minted today (valid 12 h or until midnight)
# MSTOCK_ACCESS_TOKEN=

# Optional: only if the login flow asks for credentials before the TOTP step
# MSTOCK_USERNAME=
# MSTOCK_PASSWORD=

# ---------------------------------------------------------------------------
# Public endpoints — already the defaults, listed only so you can see them.
# Change these only to point a run at a stub or a staging host.
# ---------------------------------------------------------------------------
MSTOCK_BASE_URL=https://api.mstock.trade/openapi/typea
MSTOCK_WS_URL=wss://ws.mstock.trade
